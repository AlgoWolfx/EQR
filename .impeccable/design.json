      "kind": "button",
      "description": "Fixed green primary export in either theme.",
      "html": "<button class=\"ds-primary\">Download PNG</button>",
      "css": ".ds-primary{font-family:var(--font-body,system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', sans-serif);display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:.625rem;width:100%;min-height:3rem;padding:.75rem 1rem;border-radius:.5rem;font-size:.875rem;font-weight:550;line-height:1.5;cursor:pointer;background:#254a36;color:#fff;border:1px solid #254a36}.ds-primary{transition:transform 160ms var(--ease-out,cubic-bezier(0.23,1,0.32,1)),background-color 160ms ease}.ds-primary:not(:disabled):active{transform:scale(.97)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:focus-visible{outline:2px solid var(--green,#254a36);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:background-color 100ms ease}.ds-primary:not(:disabled):active{transform:none}}@media(hover:hover) and (pointer:fine){.ds-primary:not(:disabled):hover{background:#183b28}}",
