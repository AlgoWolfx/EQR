      "html": "<div class=\"ds-formats\"><button class=\"ds-format ds-selected\" aria-pressed=\"true\">Website</button><button class=\"ds-format\" aria-pressed=\"false\">Text</button><button class=\"ds-format\" aria-pressed=\"false\">Wi-Fi</button></div>",
      "css": ".ds-formats{display:flex;flex-wrap:wrap;gap:.25rem;min-width:0}.ds-format{font-family:var(--font-body,system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:.375rem;min-height:2.75rem;padding:.5rem .75rem;background:transparent;border:0;border-radius:.5rem;color:var(--muted,#5e6561);font-size:.875rem;font-weight:400;line-height:1.5;white-space:nowrap;cursor:pointer}.ds-format.ds-selected{background:var(--soft-green,#edf3ee);color:var(--green,#254a36);font-weight:600}.ds-format{transition:transform 160ms var(--ease-out,cubic-bezier(0.23,1,0.32,1)),background-color 160ms ease}.ds-format:not(:disabled):active{transform:scale(.97)}.ds-format:disabled{opacity:.5;cursor:not-allowed}.ds-format:focus-visible{outline:2px solid var(--green,#254a36);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-format{transition:background-color 100ms ease}.ds-format:not(:disabled):active{transform:none}}@media(hover:hover) and (pointer:fine){.ds-format:not(.ds-selected):hover{background:var(--soft-green,#edf3ee)}}@media(max-width:760px){.ds-formats{flex-wrap:nowrap;overflow-x:auto;padding:.25rem;scrollbar-width:thin;scroll-padding-inline:.25rem}.ds-format{flex-shrink:0}}",
      "refersTo": "format-button"
    },
